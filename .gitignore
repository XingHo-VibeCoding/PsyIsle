# ============ 绝不上传：敏感信息 ============
# 环境变量（数据库地址、密码、API 密钥都写在这里，只在本地存在）
.env
.env.local
.env.*.local

# 密钥与证书文件
*.pem
*.key
*.p12
*.pfx
secrets.*
credentials*.json
*.keystore

# ============ 绝不上传：依赖与构建产物 ============
# 依赖目录（有 package.json 就能重装，体积巨大）
node_modules/

# 构建产物（跑 npm run build 生成，每次都能重建）
dist/
dist-ssr/

# ============ 绝不上传：本地数据 ============
# 本地数据库文件
*.db
*.sqlite
*.sqlite3
*.accdb

# 日志与临时文件
*.log
*.tmp

# ============ 系统与编辑器杂物 ============
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# 云端函数部署配置（含服务端 API Key，只本地存在，绝不入库）
cloudbaserc.json

# 工作台/助手数据目录，不属于项目代码
.workbuddy/
